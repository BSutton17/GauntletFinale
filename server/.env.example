# Copy this file to server/.env for local development. server/.env is gitignored.
# On Heroku, set the same names as Config Vars (Settings -> Reveal Config Vars).

# Your MongoDB Atlas connection string. Without it, local dev keeps accounts in memory (lost on restart);
# production refuses sign-in until it is set.
MONGO_URI=
MONGO_DB=gauntlet_finale

# Where the client is served from (comma separated). Socket.io and the API only accept these origins.
CLIENT_ORIGIN=http://localhost:5173,https://kmssykfhxzf3.netlify.app

GOOGLE_CLIENT_ID=607981026586-o3k5n213tdvhev5526v74aa9804lg74b.apps.googleusercontent.com
ADMIN_EMAIL=btpitch27@gmail.com

# Dev mode: every level unlocked, story skip, Level 3 target highlight. NEVER set this on Heroku.
GAME_DEV_MODE=1
# Lets a local browser sign in without Google (refused when NODE_ENV=production).
AUTH_DEV_LOGIN=1

PORT=3001
