{
  "name": "gauntlet-finale-server",
  "private": true,
  "version": "1.0.0",
  "description": "The Gauntlet Finale: game server (Express + Socket.io). The client lives in client/ and deploys to Netlify.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/index.js",
