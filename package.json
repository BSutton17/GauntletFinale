    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.5.0",
    "mongodb": "^6.20.0",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1"
  }
}
